---
// src/components/Header.astro
import { client, urlFor } from '../lib/sanity';

const headerQuery = `*[_type == "homeSettings"][0] {
  "logoScrollUrl": logoScroll.asset->url
}`;

const headerData = await client.fetch(headerQuery);

const logoDeScroll = headerData?.logoScrollUrl 
  ? urlFor(headerData.logoScrollUrl).width(150).fit('max').format('webp').url()
  : '';
---

<header id="main-header" class="fixed top-0 w-full z-50 py-3 md:py-6 transition-all duration-300 bg-transparent">
  <div class="container mx-auto px-6 relative flex items-center justify-center">
    
    <!-- ÁREA DEL LOGO (Clicable para volver al inicio) -->
    <a href="#hero" class="relative flex items-center justify-center h-9 md:h-12 w-64 cursor-pointer" id="logo-area" title="Volver al inicio">
      
      <div id="logo-text" class="absolute flex flex-col items-center justify-center text-white text-center transition-all duration-300">
        <span class="font-heading text-xl md:text-2xl tracking-[0.15em] leading-none uppercase text-nowrap">VK MEN</span>
        <span class="font-body text-[8px] md:text-[9px] tracking-[0.4em] mt-0.5 opacity-70 uppercase text-nowrap">Clothing Store</span>
      </div>

      <div id="logo-iso-png" class="absolute opacity-0 scale-90 transition-all duration-300">
        {logoDeScroll && (
          <img 
            src={logoDeScroll} 
            alt="VK Isotipo" 
            class="h-8 md:h-10 w-auto object-contain"
            loading="eager"
          />
        )}
      </div>
    </a>

    <!-- Enlace al Catálogo en el Header (Móvil: Icono de Franela + Ping | Desktop: Texto + Icono) -->
    <a 
      href="#catalogo" 
      id="header-catalog-link" 
      class="group absolute right-3 sm:right-6 flex items-center gap-1.5 sm:gap-2 text-[9px] sm:text-xs font-body uppercase tracking-[0.2em] font-extrabold text-[#d4af37] bg-black/70 backdrop-blur-md border border-[#d4af37]/60 hover:border-[#d4af37] transition-all duration-300 cursor-pointer py-1.5 px-2.5 sm:px-3.5 rounded-full shadow-lg animate-gold-glow opacity-100 scale-100 pointer-events-auto"
      title="Ver Catálogo"
    >
      <!-- Punto Resplandeciente Ping -->
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#d4af37] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#d4af37]"></span>
      </span>

      <!-- Icono de Franela / Camiseta -->
      <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#d4af37] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 3L2 7l4 2.5V21h12V9.5L22 7l-4-4-5 2-5-2z" />
      </svg>

      <!-- Texto solo visible en pantallas medianas en adelante -->
      <span class="hidden sm:inline">Catálogo</span>

      <!-- Flechita animada -->
      <svg class="w-3 h-3 text-[#d4af37] transform group-hover:translate-y-0.5 transition-transform animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </a>

    </div>
</header>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const header = document.querySelector("#main-header") as HTMLElement;
  const logoText = document.querySelector("#logo-text") as HTMLElement;
  const logoIso = document.querySelector("#logo-iso-png") as HTMLElement;
  const logoArea = document.querySelector("#logo-area") as HTMLElement;
  const catalogLink = document.querySelector("#header-catalog-link") as HTMLElement;

  ScrollTrigger.create({
    trigger: "body",
    start: "top top",
    end: "50", 
    onLeave: () => {
      // Al bajar: se activa el fondo blanco minimalista
      header.classList.remove('md:py-6', 'bg-transparent');
      header.classList.add('py-3', 'bg-white', 'shadow-md');
      
      logoText.classList.add('opacity-0', '-translate-y-2');
      logoIso.classList.remove('opacity-0', 'scale-90');
      logoIso.classList.add('opacity-100', 'scale-100');

      // Al scrollear hacia abajo: Desaparece el botón de catálogo
      if (catalogLink) {
        catalogLink.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
        catalogLink.classList.add('opacity-0', 'scale-90', 'pointer-events-none');
      }
    },
    onEnterBack: () => {
      // Al volver arriba: regresa a transparente
      header.classList.add('md:py-6', 'bg-transparent');
      header.classList.remove('py-3', 'bg-white', 'shadow-md');
      
      logoText.classList.remove('opacity-0', '-translate-y-2');
      logoIso.classList.add('opacity-0', 'scale-90');
      logoIso.classList.remove('opacity-100', 'scale-100');

      // Al volver a la posición inicial: Reaparece el botón de catálogo
      if (catalogLink) {
        catalogLink.classList.remove('opacity-0', 'scale-90', 'pointer-events-none');
        catalogLink.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
      }
    }
  });

  // Event listener para scroll suave hacia el inicio al hacer clic en el Logo
  logoArea?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Event listener para scroll suave hacia la altura exacta del filtro de categorías
  catalogLink?.addEventListener('click', (e) => {
    e.preventDefault();
    const catalogoSection = document.querySelector("#catalogo");
    if (catalogoSection) {
      const headerOffset = 60; // Offset para que la barra de categorías quede perfecta debajo del Header
      const elementPosition = catalogoSection.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth'
      });
    }
  });
</script>

<style is:global>
  #main-header {
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: 
      background-color 0.2s ease-out, 
      padding 0.2s ease-out, 
      box-shadow 0.2s ease-out;
  }

  @keyframes goldGlowPulse {
    0%, 100% {
      box-shadow: 0 0 8px rgba(212, 175, 55, 0.25);
    }
    50% {
      box-shadow: 0 0 18px rgba(212, 175, 55, 0.65);
    }
  }

  .animate-gold-glow {
    animation: goldGlowPulse 2.5s infinite ease-in-out;
  }
</style>