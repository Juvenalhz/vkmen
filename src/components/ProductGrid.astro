---
// src/components/ProductGrid.astro
import { client, urlFor, type Product, type Variant, type ReferencedProduct } from '../lib/sanity';
import CatalogProductImage from './CatalogProductImage.astro';

// 1. Extraemos los productos de Sanity en una sola petición (filtrando productos ocultos de la grilla)
const dataQuery = `{
  "products": *[_type == "product" && (!defined(hideFromCatalog) || hideFromCatalog == false) && (
    (!defined(isBundle) || isBundle == false) && count(variants[defined(availableSizes) && count(availableSizes) > 0]) > 0
    ||
    (isBundle == true && defined(topProduct) && defined(bottomProduct))
  )] | order(orderRank asc) {
    sku,
    name,
    category,
    price,
    isOnSale,
    offerPrice,
    hideFromCatalog,
    isBundle,
    topProduct-> {
      sku,
      name,
      category,
      price,
      isOnSale,
      offerPrice,
      variants[] {
        colorName,
        availableSizes
      }
    },
    bottomProduct-> {
      sku,
      name,
      category,
      price,
      isOnSale,
      offerPrice,
      variants[] {
        colorName,
        availableSizes
      }
    },
    variants[] {
      colorName,
      "colorHex": hex.hex,
      availableSizes,
      images[] { 
        asset->{ 
          url,
          metadata {
            dimensions {
              aspectRatio,
              width,
              height
            }
          }
        } 
      }
    }
  },
  "homeSettings": *[_type == "homeSettings"][0] {
    currency
  },
  "storeSettings": *[_type == "siteSettings"][0] {
    isotipo { asset->{ url } }
  }
}`;

const { products, homeSettings, storeSettings } = await client.fetch(dataQuery);
const currency = homeSettings?.currency || 'EUR';
const currencySymbol = currency === 'USD' ? '$' : '€';
const formatPrice = (price: number) => currency === 'USD' ? `$ ${price}` : `${price} €`;

// Ordenar las tallas en el orden lógico (S, M, L, XL, XXL)
const sizeOrder = ['S', 'M', 'L', 'XL', 'XXL'];
const sortSizes = (sizes: string[] = []) => {
  return [...sizes].sort((a, b) => {
    const iA = sizeOrder.indexOf(a);
    const iB = sizeOrder.indexOf(b);
    if (iA !== -1 && iB !== -1) return iA - iB;
    if (iA !== -1) return -1;
    if (iB !== -1) return 1;
    return a.localeCompare(b);
  });
};

const getReferencedSizes = (refProd: ReferencedProduct | undefined, targetColorName?: string) => {
  if (!refProd || !refProd.variants || !Array.isArray(refProd.variants) || refProd.variants.length === 0) return [];
  
  if (targetColorName) {
    const matchedVar = refProd.variants.find(
      (v: any) => v.colorName && v.colorName.trim().toLowerCase() === targetColorName.trim().toLowerCase()
    );
    if (matchedVar && Array.isArray(matchedVar.availableSizes) && matchedVar.availableSizes.length > 0) {
      return sortSizes(matchedVar.availableSizes);
    }
  }
  
  const set = new Set<string>();
  refProd.variants.forEach((v: any) => {
    if (Array.isArray(v.availableSizes)) {
      v.availableSizes.forEach((s: string) => set.add(s));
    }
  });
  return sortSizes(Array.from(set));
};

products.forEach((product: Product) => {
  product.variants?.forEach((variant: Variant) => {
    if (Array.isArray(variant.availableSizes)) {
      variant.availableSizes = sortSizes(variant.availableSizes);
    }
  });
});

// 2. Definimos el Isotipo de VKMEN como la imagen de respaldo global
const vkmenIsotipo = storeSettings?.isotipo?.asset
  ? urlFor(storeSettings.isotipo).width(600).height(800).fit('fill').bg('FFFFFF').format('webp').url()
  : '/placeholder.jpg'; 

/**
 * Helper para generar URLs de imágenes 100% íntegras (SIN recorte de Sanity)
 */
const getCatalogImages = (sanitySource: any) => {
  if (!sanitySource) {
    return {
      fg: vkmenIsotipo,
      bg: vkmenIsotipo
    };
  }

  return {
    fg: urlFor(sanitySource).width(1200).fit('max').format('webp').url(),
    bg: urlFor(sanitySource).width(300).height(375).fit('crop').quality(50).format('webp').url()
  };
};

// 3. Extraemos y formateamos las categorías dinámicamente de la BD con tipado explícito
const rawCategories = products.map((p: any) => p.category).filter(Boolean);
const uniqueCategories = [...new Set(rawCategories)];

const categories = [
  { title: 'Todos', value: 'all', isSpecial: false },
  { title: 'Ofertas', value: 'ofertas', isSpecial: true },
  ...uniqueCategories.map((cat: any) => ({
    title: String(cat).split('-').map((word: string) => word.charAt(0).toUpperCase() + word.slice(1)).join(' '),
    value: String(cat),
    isSpecial: false
  }))
];
---

<section id="catalogo" class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8 relative">
  
  <div class="border-b border-neutral-100 pb-6 mb-10 space-y-5">
    
    <!-- Motor de Búsqueda Minimalista e Innovador VKMEN -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="relative flex-1 max-w-md">
        <div class="relative flex items-center border-b border-neutral-200 focus-within:border-neutral-900 transition-colors duration-300 pb-2">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-neutral-400 shrink-0 mr-3">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637z" />
          </svg>
          <input 
            id="catalog-search-input" 
            type="text" 
            placeholder="Buscar por producto, colección, color o SKU..." 
            class="w-full text-xs font-mono tracking-wider text-neutral-900 placeholder:text-neutral-400 bg-transparent focus:outline-none"
            autocomplete="off"
          />
          <button 
            id="clear-catalog-search-btn" 
            class="hidden text-neutral-300 hover:text-neutral-900 transition-colors p-1 cursor-pointer"
            title="Limpiar búsqueda"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Contador Dinámico de Prendas -->
      <span id="catalog-count-badge" class="text-[10px] font-mono font-bold uppercase tracking-widest text-neutral-400 shrink-0">
        Mostrando <span id="catalog-visible-count" class="text-neutral-900 font-extrabold">{products.length}</span> prendas
      </span>
    </div>

    <!-- Barra de Categorías Horizontal -->
    <div class="relative w-full overflow-hidden flex flex-col gap-3">
      <div class="flex items-center overflow-x-auto gap-4 sm:gap-8 no-scrollbar py-1 w-full pl-0.5 pr-8">
        {categories.map((cat) => (
          <button
            data-category-btn={cat.value}
            class={`text-xs font-medium tracking-[0.15em] uppercase pb-2 pt-1 border-b-2 transition-all duration-300 whitespace-nowrap cursor-pointer flex-shrink-0 flex items-center gap-1.5 ${
              cat.isSpecial
                ? 'text-[#d4af37] border-transparent hover:text-amber-400 font-extrabold'
                : 'text-neutral-400 border-transparent hover:text-neutral-900'
            }`}
          >
            {cat.isSpecial && (
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#d4af37] opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-[#d4af37]"></span>
              </span>
            )}
            {cat.title}
          </button>
        ))}
      </div>

      <!-- Indicador Informativo cuando el Modo Ofertas está Activo -->
      <div id="offers-active-banner" class="hidden items-center justify-between bg-[#d4af37]/10 border border-[#d4af37]/30 rounded-xl px-4 py-2 text-xs text-neutral-800 transition-all duration-300">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-[#d4af37] animate-pulse"></span>
          <span class="font-medium">Modo Ofertas Activo: <strong class="font-bold text-neutral-900" id="offers-active-text">Mostrando productos en oferta</strong></span>
        </div>
        <button id="clear-offers-mode-btn" class="text-[10px] font-bold uppercase tracking-wider text-neutral-700 hover:text-neutral-900 bg-white hover:bg-neutral-100 px-3 py-1 rounded-md border border-neutral-300 shadow-sm transition-all cursor-pointer">
          Desactivar Ofertas
        </button>
      </div>

      <!-- Indicador visual de scroll móvil -->
      <div class="absolute right-0 top-0 bottom-0 w-12 bg-gradient-to-l from-white via-white/80 to-transparent pointer-events-none md:hidden flex items-center justify-end">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-neutral-400 animate-pulse">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-y-12 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-10">
    {products.map((product: Product, pIndex: number) => {
      const isBundle = Boolean(product.isBundle && product.topProduct && product.bottomProduct);
      
      const productVariants = (product.variants || []).filter((v: Variant) => {
        if (isBundle) {
          return Boolean(v && v.colorName && v.images && v.images.length > 0);
        }
        return Boolean(v && Array.isArray(v.availableSizes) && v.availableSizes.length > 0);
      });

      const defaultVariant = productVariants[0] || product.variants?.[0];
      const defaultSanityImg = defaultVariant?.images?.[0];
      const defaultImgUrls = getCatalogImages(defaultSanityImg);

      const isEffectiveOffer = Boolean(product.isOnSale && typeof product.offerPrice === 'number' && product.offerPrice < product.price);
      const discountPercent = isEffectiveOffer ? Math.round(((product.price - product.offerPrice!) / product.price) * 100) : 0;
      const effectivePrice = isEffectiveOffer ? product.offerPrice! : product.price;

      const topProd = product.topProduct;
      const topIsOffer = Boolean(topProd?.isOnSale && typeof topProd?.offerPrice === 'number' && topProd.offerPrice < (topProd.price || 0));
      const topPrice = topProd?.price || 0;
      const topEffectivePrice = topIsOffer ? topProd!.offerPrice! : topPrice;

      const bottomProd = product.bottomProduct;
      const bottomIsOffer = Boolean(bottomProd?.isOnSale && typeof bottomProd?.offerPrice === 'number' && bottomProd.offerPrice < (bottomProd.price || 0));
      const bottomPrice = bottomProd?.price || 0;
      const bottomEffectivePrice = bottomIsOffer ? bottomProd!.offerPrice! : bottomPrice;

      const topLabel = product.topProduct?.name || 'Camisa';
      const bottomLabel = product.bottomProduct?.name || 'Short';

      const defaultTopSizes = isBundle ? getReferencedSizes(product.topProduct, defaultVariant?.colorName) : [];
      const defaultBottomSizes = isBundle ? getReferencedSizes(product.bottomProduct, defaultVariant?.colorName) : [];
      const defaultSizesDisplay = isBundle 
        ? ((defaultTopSizes.length > 0 && defaultBottomSizes.length > 0) ? `Top: ${defaultTopSizes.join('·')} | Bot: ${defaultBottomSizes.join('·')}` : 'Agotado')
        : ((defaultVariant && defaultVariant.availableSizes && Array.isArray(defaultVariant.availableSizes)) ? defaultVariant.availableSizes.join(' · ') : 'Agotado');

      const searchKeywords = [
        product.name,
        product.sku,
        product.category,
        topLabel,
        bottomLabel,
        ...(product.variants || []).map((v: Variant) => v.colorName)
      ].filter(Boolean).join(' ').toLowerCase();

      const productDataJson = JSON.stringify({
        name: product.name,
        sku: product.sku,
        price: product.price,
        isOnSale: isEffectiveOffer,
        offerPrice: product.offerPrice || null,
        effectivePrice,
        discountPercent,
        formattedPrice: formatPrice(effectivePrice),
        formattedOriginalPrice: isEffectiveOffer ? formatPrice(product.price) : null,
        currencySymbol,
        isBundle,
        topLabel,
        bottomLabel,
        topProduct: topProd ? {
          sku: topProd.sku,
          name: topProd.name,
          price: topPrice,
          effectivePrice: topEffectivePrice,
          formattedPrice: formatPrice(topEffectivePrice)
        } : null,
        bottomProduct: bottomProd ? {
          sku: bottomProd.sku,
          name: bottomProd.name,
          price: bottomPrice,
          effectivePrice: bottomEffectivePrice,
          formattedPrice: formatPrice(bottomEffectivePrice)
        } : null,
        variants: productVariants.map((v: Variant) => {
          const validImages = (v.images || []).filter(img => img && img.asset);
          const firstImgUrls = getCatalogImages(validImages[0]);

          const topSizes = isBundle ? getReferencedSizes(product.topProduct, v.colorName) : [];
          const bottomSizes = isBundle ? getReferencedSizes(product.bottomProduct, v.colorName) : [];
          
          return {
            colorName: v.colorName,
            colorHex: v.colorHex,
            availableSizes: v.availableSizes || [],
            topSizes,
            bottomSizes,
            fgUrl: firstImgUrls.fg,
            bgUrl: firstImgUrls.bg,
            thumb: firstImgUrls.fg,
            images: validImages.length > 0 
              ? validImages.map((img: any) => urlFor(img).width(1200).fit('max').format('webp').url())
              : [vkmenIsotipo]
          };
        })
      });

      return (
        <div 
          data-product-card={product.category} 
          data-is-on-sale={isEffectiveOffer ? "true" : "false"}
          data-product-search={searchKeywords}
          class="group bg-white flex flex-col justify-between"
        >
          {/* Contenedor de Imagen con CatalogProductImage */}
          <div data-open-modal data-product-info={productDataJson} class="cursor-pointer">
            <CatalogProductImage
              id={`prod-img-${pIndex}`}
              bgId={`prod-bg-${pIndex}`}
              src={defaultImgUrls.fg}
              bgSrc={defaultImgUrls.bg}
              alt={product.name}
              loading={pIndex < 3 ? "eager" : "lazy"}
            >
              {isEffectiveOffer && (
                <div class="absolute top-3 left-3 z-20 flex items-center gap-1.5 bg-black/85 text-[#d4af37] border border-[#d4af37]/70 backdrop-blur-md rounded-full px-3 py-1 text-[10px] font-black tracking-wider uppercase shadow-md">
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#d4af37]"></span>
                  <span>{discountPercent}% OFF</span>
                </div>
              )}
              
              <div class="absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-20">
                <span class="bg-white/90 text-neutral-900 text-[10px] tracking-widest uppercase px-4 py-2 font-medium shadow-sm">Ver Detalle</span>
              </div>
            </CatalogProductImage>
          </div>

          <div class="mt-4 flex justify-between items-start">
            <div class="space-y-1">
              <span class="block text-[9px] font-mono tracking-widest text-neutral-400 uppercase">{product.sku}</span>
              <h2 class="text-xs font-medium tracking-wider text-neutral-800 uppercase">{product.name}</h2>
            </div>
            <div class="text-right">
              {isEffectiveOffer ? (
                <div class="flex flex-col items-end">
                  <span class="text-[10px] font-mono text-neutral-400 line-through leading-none">{formatPrice(product.price)}</span>
                  <span class="text-xs font-black tracking-wider text-neutral-900 leading-tight mt-0.5">{formatPrice(product.offerPrice!)}</span>
                </div>
              ) : (
                <p class="text-xs font-bold tracking-wider text-neutral-900">{formatPrice(product.price)}</p>
              )}
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-neutral-100 flex justify-between items-center">
            <div class="flex gap-2.5">
              {(product.variants || []).map((v: Variant, vIndex: number) => {
                const swatchUrls = getCatalogImages(v.images?.[0]);
                
                const topSizes = isBundle ? getReferencedSizes(product.topProduct, v.colorName) : [];
                const bottomSizes = isBundle ? getReferencedSizes(product.bottomProduct, v.colorName) : [];

                const sizesString = isBundle
                  ? ((topSizes.length > 0 && bottomSizes.length > 0) ? `Top: ${topSizes.join('·')} | Bot: ${bottomSizes.join('·')}` : 'Agotado')
                  : ((v && v.availableSizes && Array.isArray(v.availableSizes)) ? v.availableSizes.join(' · ') : 'Agotado');

                return (
                  <button 
                    data-color-select
                    data-variant-index={vIndex}
                    data-target-img={`prod-img-${pIndex}`}
                    data-target-bg={`prod-bg-${pIndex}`}
                    data-target-sizes={`prod-sizes-${pIndex}`}
                    data-img-src={swatchUrls.fg}
                    data-bg-src={swatchUrls.bg}
                    data-sizes={sizesString}
                    class={`w-5 h-5 rounded-full border border-neutral-300 block shadow-sm cursor-pointer transition-transform hover:scale-110 focus:outline-none ${vIndex === 0 ? 'ring-1 ring-neutral-900 ring-offset-2' : ''}`}
                    style={`background-color: ${v.colorHex}`}
                    title={v.colorName}
                  />
                );
              })}
            </div>
            
            <span id={`prod-sizes-${pIndex}`} class="text-[9px] font-bold tracking-widest text-neutral-500 font-mono">
              {defaultSizesDisplay}
            </span>
          </div>

          <button 
            data-open-modal 
            data-product-info={productDataJson} 
            class="mt-4 w-full block text-center border border-neutral-200 text-neutral-600 text-[9px] font-bold tracking-[0.15em] uppercase py-2 hover:border-neutral-900 hover:bg-neutral-900 hover:text-white transition-all duration-300 cursor-pointer"
          >
            Seleccionar Talla
          </button>
        </div>
      );
    })}

    <!-- Mensaje Elegante cuando no hay resultados de búsqueda -->
    <div id="no-products-found" class="hidden col-span-full py-20 text-center flex-col items-center justify-center space-y-4 bg-neutral-50/60 rounded-2xl border border-dashed border-neutral-200">
      <div class="w-12 h-12 rounded-full bg-neutral-100 flex items-center justify-center text-neutral-400 mx-auto shadow-xs">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637z" />
        </svg>
      </div>
      <div class="space-y-1">
        <h3 class="text-xs font-bold uppercase tracking-widest text-neutral-900">Sin resultados de búsqueda</h3>
        <p class="text-xs text-neutral-400 max-w-sm mx-auto">No encontramos ninguna prenda que coincida con "<span id="search-query-highlight" class="font-bold text-neutral-700"></span>".</p>
      </div>
      <button id="reset-search-btn" class="text-[10px] font-bold uppercase tracking-widest bg-neutral-900 text-white px-6 py-2.5 hover:bg-neutral-800 transition-all cursor-pointer shadow-sm">
        Limpiar Búsqueda
      </button>
    </div>
  </div>

  <!-- Modal de Detalle de Producto -->
  <div id="product-modal" data-lenis-prevent class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
    <div id="product-modal-content" data-lenis-prevent tabindex="0" class="bg-white w-full max-w-4xl max-h-[95vh] md:max-h-[90vh] overflow-y-auto rounded-none flex flex-col md:flex-row relative shadow-2xl overscroll-contain outline-none">
      
      <button id="close-modal" class="absolute top-4 right-4 z-20 p-2 text-neutral-400 hover:text-neutral-900 cursor-pointer bg-white/80 md:bg-transparent rounded-full shadow-sm md:shadow-none">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Visor de Imagen en Modal (Proporción 4:5 Completa) -->
      <div id="modal-img-container" class="w-full md:w-1/2 bg-white flex flex-col justify-between border-b md:border-b-0 md:border-r border-neutral-100 transition-all duration-300">
        <div class="w-full aspect-[4/5] overflow-hidden relative group/zoom bg-neutral-50">
          <img id="modal-img" src="" alt="" class="w-full h-full object-cover object-top transition-all duration-300 cursor-zoom-in" style="transition: opacity 0.15s ease-in-out;">
          <div class="absolute bottom-3 right-3 bg-black/40 text-white pointer-events-none p-1.5 rounded-full backdrop-blur-sm opacity-0 group-hover/zoom:opacity-100 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637zM10.5 7.5v6m3-3h-6" />
            </svg>
          </div>

          <!-- Miniaturas Flotantes Verticales en la Esquina Superior Izquierda -->
          <div id="modal-thumbnails-container" class="absolute top-4 left-4 z-20 hidden flex-col gap-2.5 p-2 bg-white/80 backdrop-blur-md rounded-2xl shadow-xl max-h-[85%] overflow-y-auto no-scrollbar border border-white/60 transition-all duration-300"></div>
        </div>
      </div>

      <div class="w-full md:w-1/2 p-6 md:p-8 flex flex-col justify-between bg-white">
        <div class="space-y-5">
          <div>
            <span id="modal-sku" class="text-[10px] font-mono tracking-widest text-neutral-400 uppercase"></span>
            <h2 id="modal-title" class="text-xl font-light tracking-wide text-neutral-900 uppercase font-serif mt-1"></h2>
            <p id="modal-price" class="text-lg font-bold text-neutral-900 mt-2"></p>
          </div>

          <!-- Pestañas de Selección de Modo (Conjunto vs Piezas Individuales) -->
          <div id="modal-bundle-mode-container" class="hidden"></div>

          <div>
            <p class="text-[10px] font-medium tracking-widest text-neutral-400 uppercase mb-2.5">Color disponible</p>
            <div id="modal-colors-container" class="flex gap-3"></div>
          </div>

          <div>
            <p id="modal-sizes-label" class="text-[10px] font-medium tracking-widest text-neutral-400 uppercase mb-2.5">Selecciona tu talla</p>
            <div id="modal-sizes-container" class="flex flex-wrap gap-2"></div>
          </div>
        </div>

        <div class="mt-6 pt-2">
          <button 
            id="modal-add-to-cart-btn"
            class="w-full block text-center bg-neutral-900 text-white text-xs font-semibold tracking-[0.2em] uppercase py-3.5 hover:bg-neutral-800 transition-all cursor-pointer disabled:opacity-50"
          >
            Añadir al Carrito
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Lightbox -->
  <div id="image-lightbox" class="fixed inset-0 z-55 hidden items-center justify-center bg-black/95 backdrop-blur-md cursor-zoom-out select-none">
    <button id="close-lightbox" class="absolute top-6 right-6 p-3 text-white/70 hover:text-white transition-colors cursor-pointer">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="max-w-[95vw] max-h-[90vh] flex items-center justify-center">
      <img id="lightbox-img" src="" alt="VKMEN Detalle Expandido" class="max-w-full max-h-[85vh] object-contain shadow-2xl transition-transform duration-300 ease-out">
    </div>
  </div>

  <div 
    id="floating-cart-btn" 
    class="fixed bottom-6 right-6 z-40 bg-neutral-900 text-white p-4 rounded-full shadow-xl transition-all duration-300 transform translate-y-20 opacity-0 scale-90 hover:bg-neutral-800 hover:scale-105 active:scale-95 cursor-pointer flex items-center justify-center"
    title="Ver mi bolsa de compras"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375 .375 0 1 1-.75 0 .375 .375 0 0 1 .75 0Zm7.5 0a.375 .375 0 1 1-.75 0 .375 .375 0 0 1 .75 0Z" />
    </svg>
    <span 
      id="floating-cart-count" 
      class="absolute -top-1 -right-1 bg-amber-600 text-white font-mono text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center border border-neutral-900"
    >
      0
    </span>
  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  import { cartItems, addCartItem } from '../store/cartStore.js';

  const floatingCartBtn = document.getElementById('floating-cart-btn') as HTMLElement | null;
  const floatingCartCount = document.getElementById('floating-cart-count') as HTMLElement | null;
  const cartDrawer = document.getElementById('cart-drawer') as HTMLElement | null;
  const cartOverlay = document.getElementById('cart-overlay') as HTMLElement | null;

  // --- 1. ESCUCHADOR REACTIVO DEL CARRITO ---
  cartItems.subscribe((items: any[]) => {
    if (!floatingCartBtn || !floatingCartCount) return;
    
    const totalQuantity = items.reduce((acc: number, item: any) => acc + item.quantity, 0);
    floatingCartCount.textContent = totalQuantity.toString();

    if (totalQuantity > 0) {
      floatingCartBtn.classList.remove('translate-y-20', 'opacity-0', 'scale-90');
      floatingCartBtn.classList.add('translate-y-0', 'opacity-100', 'scale-100');
    } else {
      floatingCartBtn.classList.remove('translate-y-0', 'opacity-100', 'scale-100');
      floatingCartBtn.classList.add('translate-y-20', 'opacity-0', 'scale-90');
    }
  });

  floatingCartBtn?.addEventListener('click', () => {
    if (cartDrawer && cartOverlay) {
      cartDrawer.classList.remove('translate-x-full');
      cartOverlay.classList.remove('hidden');
      setTimeout(() => cartOverlay.classList.remove('opacity-0'), 10);
      document.body.style.overflow = 'hidden';
    }
  });

  // --- 2. FILTRADO REVOLUCIONARIO DE CATEGORÍAS, BÚSQUEDA Y MODO OFERTAS ---
  const catButtons = document.querySelectorAll('[data-category-btn]');
  const productCards = document.querySelectorAll('[data-product-card]');
  const offersActiveBanner = document.getElementById('offers-active-banner');
  const offersActiveText = document.getElementById('offers-active-text');
  const clearOffersBtn = document.getElementById('clear-offers-mode-btn');

  const searchInput = document.getElementById('catalog-search-input') as HTMLInputElement | null;
  const clearSearchBtn = document.getElementById('clear-catalog-search-btn');
  const visibleCountEl = document.getElementById('catalog-visible-count');
  const noProductsFoundEl = document.getElementById('no-products-found');
  const searchQueryHighlight = document.getElementById('search-query-highlight');
  const resetSearchBtn = document.getElementById('reset-search-btn');

  let activeCategory = 'all';
  let isOffersOnlyActive = false;
  let searchQuery = '';

  const updateFilteringUI = () => {
    catButtons.forEach(btn => {
      const catVal = btn.getAttribute('data-category-btn');
      
      if (catVal === 'ofertas') {
        if (isOffersOnlyActive) {
          btn.className = "text-xs font-black tracking-[0.15em] uppercase px-3.5 py-1 bg-[#d4af37]/20 text-[#d4af37] border border-[#d4af37]/60 rounded-full shadow-sm backdrop-blur-sm transition-all duration-300 whitespace-nowrap cursor-pointer flex-shrink-0 flex items-center gap-1.5 ring-2 ring-[#d4af37]/20 scale-105";
        } else {
          btn.className = "text-xs font-extrabold tracking-[0.15em] uppercase pb-2 pt-1 text-[#d4af37] border-b-2 border-transparent hover:text-amber-400 transition-all duration-300 whitespace-nowrap cursor-pointer flex-shrink-0 flex items-center gap-1.5";
        }
      } else {
        if (catVal === activeCategory) {
          btn.className = "text-xs font-bold tracking-[0.15em] uppercase pb-2 pt-1 border-b-2 border-neutral-900 text-neutral-900 transition-all duration-300 whitespace-nowrap cursor-pointer flex-shrink-0";
        } else {
          btn.className = "text-xs font-medium tracking-[0.15em] uppercase pb-2 pt-1 border-b-2 border-transparent text-neutral-400 hover:text-neutral-900 transition-all duration-300 whitespace-nowrap cursor-pointer flex-shrink-0";
        }
      }
    });

    if (offersActiveBanner) {
      if (isOffersOnlyActive) {
        offersActiveBanner.classList.remove('hidden');
        offersActiveBanner.classList.add('flex');
        if (offersActiveText) {
          const activeBtnEl = document.querySelector(`[data-category-btn="${activeCategory}"]`);
          const catTitle = activeCategory === 'all' 
            ? 'Todos los productos' 
            : (activeBtnEl?.textContent?.trim() || activeCategory);
          offersActiveText.textContent = `Mostrando ofertas en ${catTitle}`;
        }
      } else {
        offersActiveBanner.classList.remove('flex');
        offersActiveBanner.classList.add('hidden');
      }
    }

    let visibleCount = 0;
    const normalizedQuery = searchQuery.trim().toLowerCase();

    productCards.forEach(card => {
      const productCategory = card.getAttribute('data-product-card');
      const isOnSale = card.getAttribute('data-is-on-sale') === 'true';
      const searchData = card.getAttribute('data-product-search') || '';

      const matchesCategory = (activeCategory === 'all' || productCategory === activeCategory);
      const matchesOffers = (!isOffersOnlyActive || isOnSale);
      const matchesSearch = (!normalizedQuery || searchData.includes(normalizedQuery));

      if (matchesCategory && matchesOffers && matchesSearch) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (visibleCountEl) {
      visibleCountEl.textContent = visibleCount.toString();
    }

    if (noProductsFoundEl) {
      if (visibleCount === 0) {
        noProductsFoundEl.classList.remove('hidden');
        noProductsFoundEl.classList.add('flex');
        if (searchQueryHighlight) {
          searchQueryHighlight.textContent = searchQuery;
        }
      } else {
        noProductsFoundEl.classList.remove('flex');
        noProductsFoundEl.classList.add('hidden');
      }
    }

    if (clearSearchBtn) {
      if (normalizedQuery.length > 0) {
        clearSearchBtn.classList.remove('hidden');
      } else {
        clearSearchBtn.classList.add('hidden');
      }
    }
  };

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    updateFilteringUI();
  });

  clearSearchBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    updateFilteringUI();
    searchInput?.focus();
  });

  resetSearchBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    activeCategory = 'all';
    isOffersOnlyActive = false;
    updateFilteringUI();
  });

  catButtons.forEach(button => {
    button.addEventListener('click', () => {
      const selectedCategory = button.getAttribute('data-category-btn');

      if (selectedCategory === 'ofertas') {
        isOffersOnlyActive = !isOffersOnlyActive;
      } else {
        if (selectedCategory) {
          activeCategory = selectedCategory;
        }
      }

      updateFilteringUI();
    });
  });

  clearOffersBtn?.addEventListener('click', () => {
    isOffersOnlyActive = false;
    updateFilteringUI();
  });

  updateFilteringUI();

  // --- 3. CAMBIO DE COLOR EN LA GRILLA CON AMBIENT BLUR ---
  const colorButtons = document.querySelectorAll('[data-color-select]');
  colorButtons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const targetImgId = btn.getAttribute('data-target-img');
      const targetBgId = btn.getAttribute('data-target-bg');
      const targetSizesId = btn.getAttribute('data-target-sizes');
      const newImgSrc = btn.getAttribute('data-img-src');
      const newBgSrc = btn.getAttribute('data-bg-src');
      const newSizes = btn.getAttribute('data-sizes');
      const vIndex = btn.getAttribute('data-variant-index');

      const card = btn.closest('[data-product-card]');
      if (card && vIndex) {
        card.setAttribute('data-active-variant-index', vIndex);
      }

      if (targetImgId && newImgSrc) {
        const imgElement = document.getElementById(targetImgId) as HTMLImageElement;
        const bgElement = targetBgId ? document.getElementById(targetBgId) as HTMLImageElement : null;

        if (imgElement && imgElement.src !== newImgSrc) {
          imgElement.style.opacity = '0.3';
          if (bgElement) bgElement.style.opacity = '0.2';
          
          const tempImg = new Image();
          tempImg.src = newImgSrc;
          try { await tempImg.decode(); } catch(e) {}
          
          imgElement.src = newImgSrc;
          if (bgElement && newBgSrc) bgElement.src = newBgSrc;

          imgElement.style.opacity = '1';
          if (bgElement) bgElement.style.opacity = '0.6';
        }
      }
      if (targetSizesId && newSizes) {
        const sizesElement = document.getElementById(targetSizesId);
        if (sizesElement) sizesElement.textContent = newSizes;
      }
      const parentContainer = btn.parentElement;
      if (parentContainer) {
        const siblingButtons = parentContainer.querySelectorAll('[data-color-select]');
        siblingButtons.forEach(sBtn => sBtn.classList.remove('ring-1', 'ring-neutral-900', 'ring-offset-2'));
      }
      btn.classList.add('ring-1', 'ring-neutral-900', 'ring-offset-2');
    });
  });

  // --- 4. PRECARGA AGRESIVA OPTIMIZADA ---
  const executeUltraPreload = () => {
    colorButtons.forEach(btn => {
      const imgSrc = btn.getAttribute('data-img-src');
      const bgSrc = btn.getAttribute('data-bg-src');
      if (imgSrc && !imgSrc.includes('placeholder')) {
        const img = new Image(); img.src = imgSrc;
      }
      if (bgSrc && !bgSrc.includes('placeholder')) {
        const bg = new Image(); bg.src = bgSrc;
      }
    });

    const openModalElements = document.querySelectorAll('[data-open-modal]');
    openModalElements.forEach(element => {
      const rawData = element.getAttribute('data-product-info');
      if (!rawData) return;
      try {
        const product = JSON.parse(rawData);
        product.variants?.forEach((v: any) => {
          if (v.thumb && !v.thumb.includes('placeholder')) { const i = new Image(); i.src = v.thumb; }
          v.images?.forEach((imgUrl: string) => {
            if (imgUrl && !imgUrl.includes('placeholder')) { const i = new Image(); i.src = imgUrl; }
          });
        });
      } catch (err) {}
    });
  };

  const globalScope = typeof window !== 'undefined' ? (window as any) : null;
  if (globalScope) {
    if (typeof globalScope.requestIdleCallback === 'function') {
      globalScope.requestIdleCallback(executeUltraPreload);
    } else {
      globalScope.addEventListener('load', executeUltraPreload);
    }
  }

  // --- 5. LÓGICA DEL MODAL ---
  const openModalElements = document.querySelectorAll('[data-open-modal]');
  const modal = document.getElementById('product-modal') as HTMLElement | null;
  const closeModalBtn = document.getElementById('close-modal') as HTMLElement | null;
  
  const modalImgContainer = document.getElementById('modal-img-container') as HTMLElement | null;
  const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
  const modalBgImg = document.getElementById('modal-bg-img') as HTMLImageElement | null;
  const modalSku = document.getElementById('modal-sku') as HTMLElement | null;
  const modalTitle = document.getElementById('modal-title') as HTMLElement | null;
  const modalPrice = document.getElementById('modal-price') as HTMLElement | null;
  const modalBundleModeContainer = document.getElementById('modal-bundle-mode-container') as HTMLElement | null;
  const modalColorsContainer = document.getElementById('modal-colors-container') as HTMLElement | null;
  const modalSizesLabel = document.getElementById('modal-sizes-label') as HTMLElement | null;
  const modalSizesContainer = document.getElementById('modal-sizes-container') as HTMLElement | null;
  const modalThumbnailsContainer = document.getElementById('modal-thumbnails-container') as HTMLElement | null;
  const addToCartBtn = document.getElementById('modal-add-to-cart-btn') as HTMLButtonElement | null;

  const lightbox = document.getElementById('image-lightbox') as HTMLElement | null;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;

  let activeProduct: any = null;
  let activeVariant: any = null;
  let activeSize: string = '';
  let activeTopSize: string = '';
  let activeBottomSize: string = '';
  let activePurchaseMode: 'full' | 'top' | 'bottom' = 'full';

  openModalElements.forEach(element => {
    element.addEventListener('click', () => {
      const rawData = element.getAttribute('data-product-info');
      if (!rawData || !modal) return;
      
      if (modalImg) modalImg.src = ''; 
      if (modalBgImg) modalBgImg.src = '';

      const card = element.closest('[data-product-card]');
      const activeIndex = card ? parseInt(card.getAttribute('data-active-variant-index') || '0', 10) : 0;

      activeProduct = JSON.parse(rawData);
      activeVariant = activeProduct.variants?.[activeIndex] || activeProduct.variants?.[0];
      activePurchaseMode = 'full';

      if (activeProduct.isBundle) {
        const topSizes = activeVariant?.topSizes || [];
        const bottomSizes = activeVariant?.bottomSizes || [];
        activeTopSize = topSizes[0] || '';
        activeBottomSize = bottomSizes[0] || '';
        activeSize = (topSizes.length > 0 && bottomSizes.length > 0)
          ? `Conjunto: ${activeProduct.topLabel || 'Camisa'} ${activeTopSize} + ${activeProduct.bottomLabel || 'Short'} ${activeBottomSize}`
          : '';
      } else {
        const initialSizes = activeVariant?.availableSizes || [];
        activeSize = initialSizes[0] || '';
      }

      const updateHeaderAndPrice = () => {
        if (!activeProduct) return;

        if (activeProduct.isBundle) {
          if (activePurchaseMode === 'full') {
            if (modalSku) modalSku.textContent = `SKU CONJUNTO: ${activeProduct.sku}`;
            if (modalTitle) modalTitle.textContent = activeProduct.name;
            if (modalPrice) {
              if (activeProduct.isOnSale) {
                modalPrice.innerHTML = `
                  <div class="flex items-center gap-3 mt-2">
                    <span class="text-xl font-black text-neutral-900">${activeProduct.formattedPrice}</span>
                    <span class="text-base font-mono text-neutral-400 line-through">${activeProduct.formattedOriginalPrice}</span>
                    <span class="bg-black/85 border border-[#d4af37]/70 text-[#d4af37] text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider shadow-sm flex items-center gap-1.5">
                      <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#d4af37]"></span>
                      ${activeProduct.discountPercent}% OFF
                    </span>
                  </div>
                `;
              } else {
                modalPrice.textContent = activeProduct.formattedPrice;
              }
            }
          } else if (activePurchaseMode === 'top') {
            const top = activeProduct.topProduct;
            if (modalSku) modalSku.textContent = `SKU: ${top?.sku || activeProduct.sku}`;
            if (modalTitle) modalTitle.textContent = top?.name || activeProduct.topLabel || 'Prenda Superior';
            if (modalPrice) modalPrice.textContent = top?.formattedPrice || activeProduct.formattedPrice;
          } else if (activePurchaseMode === 'bottom') {
            const bottom = activeProduct.bottomProduct;
            if (modalSku) modalSku.textContent = `SKU: ${bottom?.sku || activeProduct.sku}`;
            if (modalTitle) modalTitle.textContent = bottom?.name || activeProduct.bottomLabel || 'Prenda Inferior';
            if (modalPrice) modalPrice.textContent = bottom?.formattedPrice || activeProduct.formattedPrice;
          }
        } else {
          if (modalSku) modalSku.textContent = `SKU: ${activeProduct.sku}`;
          if (modalTitle) modalTitle.textContent = activeProduct.name;
          if (modalPrice) {
            if (activeProduct.isOnSale) {
              modalPrice.innerHTML = `
                <div class="flex items-center gap-3 mt-2">
                  <span class="text-xl font-black text-neutral-900">${activeProduct.formattedPrice}</span>
                  <span class="text-base font-mono text-neutral-400 line-through">${activeProduct.formattedOriginalPrice}</span>
                  <span class="bg-black/85 border border-[#d4af37]/70 text-[#d4af37] text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider shadow-sm flex items-center gap-1.5">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#d4af37]"></span>
                    ${activeProduct.discountPercent}% OFF
                  </span>
                </div>
              `;
            } else {
              modalPrice.textContent = activeProduct.formattedPrice || (activeProduct.currencySymbol === '$' ? `$ ${activeProduct.price}` : `${activeProduct.price} €`);
            }
          }
        }
      };

      const renderPurchaseModeTabs = () => {
        if (!modalBundleModeContainer) return;

        if (!activeProduct.isBundle) {
          modalBundleModeContainer.innerHTML = '';
          modalBundleModeContainer.classList.add('hidden');
          if (modalSizesLabel) modalSizesLabel.textContent = 'Selecciona tu talla';
          return;
        }

        modalBundleModeContainer.classList.remove('hidden');
        if (modalSizesLabel) {
          modalSizesLabel.textContent = activePurchaseMode === 'full' 
            ? 'Selecciona las tallas del conjunto' 
            : `Selecciona tu talla (${activePurchaseMode === 'top' ? activeProduct.topLabel : activeProduct.bottomLabel})`;
        }

        const topName = activeProduct.topLabel || 'Camisa';
        const bottomName = activeProduct.bottomLabel || 'Short';

        modalBundleModeContainer.innerHTML = `
          <p class="text-[10px] font-medium tracking-widest text-neutral-400 uppercase mb-2">Opción de Compra</p>
          <div class="grid grid-cols-3 gap-2 p-1 bg-neutral-100 rounded-lg">
            <button type="button" data-mode-btn="full" class="text-center py-2 px-1 text-[10px] font-extrabold uppercase tracking-wider rounded-md transition-all cursor-pointer ${
              activePurchaseMode === 'full' ? 'bg-neutral-900 text-white shadow-sm' : 'text-neutral-600 hover:text-neutral-900'
            }">
              Conjunto
            </button>
            <button type="button" data-mode-btn="top" class="text-center py-2 px-1 text-[10px] font-extrabold uppercase tracking-wider rounded-md transition-all cursor-pointer ${
              activePurchaseMode === 'top' ? 'bg-neutral-900 text-white shadow-sm' : 'text-neutral-600 hover:text-neutral-900'
            }">
              Sólo ${topName}
            </button>
            <button type="button" data-mode-btn="bottom" class="text-center py-2 px-1 text-[10px] font-extrabold uppercase tracking-wider rounded-md transition-all cursor-pointer ${
              activePurchaseMode === 'bottom' ? 'bg-neutral-900 text-white shadow-sm' : 'text-neutral-600 hover:text-neutral-900'
            }">
              Sólo ${bottomName}
            </button>
          </div>
        `;

        modalBundleModeContainer.querySelectorAll('[data-mode-btn]').forEach(btn => {
          btn.addEventListener('click', () => {
            const mode = btn.getAttribute('data-mode-btn') as 'full' | 'top' | 'bottom';
            if (mode) {
              activePurchaseMode = mode;
              renderPurchaseModeTabs();
              updateHeaderAndPrice();
              updateModalContent(activeVariant);
            }
          });
        });
      };

      const updateModalContent = async (variant: any) => {
        activeVariant = variant;
        
        if (modalImg) {
          if (variant?.thumb) modalImg.src = variant.thumb;
          if (modalBgImg && (variant?.bgUrl || variant?.thumb)) {
            modalBgImg.src = variant.bgUrl || variant.thumb;
          }
          
          if (variant?.images?.[0]) {
            const highResImage = new Image();
            highResImage.src = variant.images[0];
            try {
              await highResImage.decode();
              if (activeVariant === variant) {
                modalImg.src = variant.images[0];
                if (modalBgImg) modalBgImg.src = variant.bgUrl || variant.images[0];
              }
            } catch (e) {
              if (activeVariant === variant) {
                modalImg.src = variant.images[0];
                if (modalBgImg) modalBgImg.src = variant.bgUrl || variant.images[0];
              }
            }
          }
        }
        
        if (modalThumbnailsContainer) {
          modalThumbnailsContainer.innerHTML = '';
          if (variant?.images && variant.images.length > 1) {
            modalThumbnailsContainer.classList.remove('hidden');
            modalThumbnailsContainer.classList.add('flex');

            variant.images.forEach((imgUrl: string, idx: number) => {
              const thumbBtn = document.createElement('button');
              thumbBtn.type = 'button';
              thumbBtn.className = `w-12 h-14 rounded-lg bg-white border overflow-hidden cursor-pointer flex-shrink-0 transition-all transform hover:scale-105 ${
                idx === 0 ? 'border-neutral-900 ring-2 ring-neutral-900/30 opacity-100 scale-105' : 'border-neutral-200 opacity-70 hover:opacity-100'
              }`;
              
              const thumbImg = document.createElement('img');
              thumbImg.src = imgUrl;
              thumbImg.className = 'w-full h-full object-cover object-top';
              thumbBtn.appendChild(thumbImg);
              
              thumbBtn.addEventListener('click', async () => {
                if (modalImg) {
                  modalImg.style.opacity = '0.4';
                  const tImg = new Image();
                  tImg.src = imgUrl;
                  try { await tImg.decode(); } catch(e) {}
                  modalImg.src = imgUrl;
                  if (modalBgImg) modalBgImg.src = imgUrl;
                  modalImg.style.opacity = '1';
                }
                const allThumbs = modalThumbnailsContainer.querySelectorAll('button');
                allThumbs.forEach(b => {
                  b.className = 'w-12 h-14 rounded-lg bg-white border border-neutral-200 opacity-70 hover:opacity-100 overflow-hidden cursor-pointer flex-shrink-0 transition-all transform hover:scale-105';
                });
                thumbBtn.className = 'w-12 h-14 rounded-lg bg-white border border-neutral-900 ring-2 ring-neutral-900/30 opacity-100 scale-105 overflow-hidden cursor-pointer flex-shrink-0 transition-all transform';
              });

              modalThumbnailsContainer.appendChild(thumbBtn);
            });
          } else {
            modalThumbnailsContainer.classList.remove('flex');
            modalThumbnailsContainer.classList.add('hidden');
          }
        }

        if (modalSizesContainer) {
          modalSizesContainer.innerHTML = '';

          if (activeProduct.isBundle) {
            const topSizes: string[] = variant?.topSizes || [];
            const bottomSizes: string[] = variant?.bottomSizes || [];

            if (activePurchaseMode === 'full') {
              if (topSizes.length === 0 || bottomSizes.length === 0) {
                modalSizesContainer.innerHTML = `
                  <div class="w-full bg-amber-50 border border-amber-200 text-amber-800 text-xs px-4 py-3 rounded-md font-medium">
                    ⚠️ Este conjunto no tiene stock disponible para esta combinación.
                  </div>
                `;
                if (addToCartBtn) {
                  addToCartBtn.disabled = true;
                  addToCartBtn.textContent = 'Agotado';
                  addToCartBtn.classList.add('opacity-50', 'cursor-not-allowed');
                }
                return;
              }

              if (!topSizes.includes(activeTopSize)) activeTopSize = topSizes[0] || '';
              if (!bottomSizes.includes(activeBottomSize)) activeBottomSize = bottomSizes[0] || '';

              const updateCombinedSize = () => {
                activeSize = `Conjunto: ${activeProduct.topLabel || 'Camisa'} ${activeTopSize} + ${activeProduct.bottomLabel || 'Short'} ${activeBottomSize}`;
                const summaryEl = document.getElementById('bundle-size-summary');
                if (summaryEl) {
                  summaryEl.textContent = activeSize;
                }
              };

              const wrapper = document.createElement('div');
              wrapper.className = 'w-full space-y-4';

              // Bloque Superior
              const topSection = document.createElement('div');
              topSection.className = 'space-y-1.5';
              topSection.innerHTML = `<p class="text-[10px] font-bold tracking-widest text-neutral-600 uppercase">1. Talla Superior (${activeProduct.topLabel || 'Camisa'})</p>`;
              const topBtnsDiv = document.createElement('div');
              topBtnsDiv.className = 'flex flex-wrap gap-2';

              topSizes.forEach((sizeStr: string) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none ${
                  sizeStr === activeTopSize
                    ? 'border-neutral-900 bg-neutral-900 text-white shadow-sm'
                    : 'border-neutral-200 bg-neutral-50 text-neutral-700 hover:border-neutral-400'
                }`;
                btn.textContent = sizeStr;
                btn.addEventListener('click', () => {
                  activeTopSize = sizeStr;
                  topBtnsDiv.querySelectorAll('button').forEach(b => {
                    b.className = 'border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none border-neutral-200 bg-neutral-50 text-neutral-700 hover:border-neutral-400';
                  });
                  btn.className = 'border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none border-neutral-900 bg-neutral-900 text-white shadow-sm';
                  updateCombinedSize();
                });
                topBtnsDiv.appendChild(btn);
              });
              topSection.appendChild(topBtnsDiv);
              wrapper.appendChild(topSection);

              // Bloque Inferior
              const bottomSection = document.createElement('div');
              bottomSection.className = 'space-y-1.5';
              bottomSection.innerHTML = `<p class="text-[10px] font-bold tracking-widest text-neutral-600 uppercase">2. Talla Inferior (${activeProduct.bottomLabel || 'Short'})</p>`;
              const bottomBtnsDiv = document.createElement('div');
              bottomBtnsDiv.className = 'flex flex-wrap gap-2';

              bottomSizes.forEach((sizeStr: string) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none ${
                  sizeStr === activeBottomSize
                    ? 'border-neutral-900 bg-neutral-900 text-white shadow-sm'
                    : 'border-neutral-200 bg-neutral-50 text-neutral-700 hover:border-neutral-400'
                }`;
                btn.textContent = sizeStr;
                btn.addEventListener('click', () => {
                  activeBottomSize = sizeStr;
                  bottomBtnsDiv.querySelectorAll('button').forEach(b => {
                    b.className = 'border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none border-neutral-200 bg-neutral-50 text-neutral-700 hover:border-neutral-400';
                  });
                  btn.className = 'border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none border-neutral-900 bg-neutral-900 text-white shadow-sm';
                  updateCombinedSize();
                });
                bottomBtnsDiv.appendChild(btn);
              });
              bottomSection.appendChild(bottomBtnsDiv);
              wrapper.appendChild(bottomSection);

              modalSizesContainer.appendChild(wrapper);
              updateCombinedSize();
            } else {
              // Modo Pieza Única (Sólo Top o Sólo Bottom)
              const singleSizes = activePurchaseMode === 'top' ? topSizes : bottomSizes;
              const labelName = activePurchaseMode === 'top' ? (activeProduct.topLabel || 'Camisa') : (activeProduct.bottomLabel || 'Short');

              if (singleSizes.length === 0) {
                modalSizesContainer.innerHTML = `
                  <div class="w-full bg-neutral-100 text-neutral-500 text-xs px-4 py-2 rounded-md font-mono">
                    Agotado para ${labelName}
                  </div>
                `;
                if (addToCartBtn) {
                  addToCartBtn.disabled = true;
                  addToCartBtn.textContent = 'Agotado';
                  addToCartBtn.classList.add('opacity-50', 'cursor-not-allowed');
                }
                return;
              }

              let currentSelected = activePurchaseMode === 'top' ? activeTopSize : activeBottomSize;
              if (!singleSizes.includes(currentSelected)) {
                currentSelected = singleSizes[0] || '';
                if (activePurchaseMode === 'top') activeTopSize = currentSelected;
                else activeBottomSize = currentSelected;
              }
              activeSize = currentSelected;

              singleSizes.forEach((sizeStr: string) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none ${
                  sizeStr === currentSelected
                    ? 'border-neutral-900 bg-neutral-900 text-white shadow-sm'
                    : 'border-neutral-200 bg-neutral-50 text-neutral-700 hover:border-neutral-400'
                }`;
                btn.textContent = sizeStr;
                btn.addEventListener('click', () => {
                  if (activePurchaseMode === 'top') activeTopSize = sizeStr;
                  else activeBottomSize = sizeStr;
                  activeSize = sizeStr;

                  modalSizesContainer.querySelectorAll('button').forEach(b => {
                    b.className = 'border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none border-neutral-200 bg-neutral-50 text-neutral-700 hover:border-neutral-400';
                  });
                  btn.className = 'border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none border-neutral-900 bg-neutral-900 text-white shadow-sm';
                });
                modalSizesContainer.appendChild(btn);
              });
            }

            if (addToCartBtn) {
              addToCartBtn.disabled = false;
              addToCartBtn.textContent = 'Añadir al Carrito';
              addToCartBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
          } else {
            // Producto Estándar Individual
            const sizesList = variant?.availableSizes || [];
            if (sizesList.length === 0) {
              modalSizesContainer.innerHTML = `
                <div class="w-full bg-neutral-100 text-neutral-500 text-xs px-4 py-2 rounded-md font-mono">
                  Producto Agotado
                </div>
              `;
              if (addToCartBtn) {
                addToCartBtn.disabled = true;
                addToCartBtn.textContent = 'Agotado';
                addToCartBtn.classList.add('opacity-50', 'cursor-not-allowed');
              }
              return;
            }

            if (!sizesList.includes(activeSize)) {
              activeSize = sizesList[0] || '';
            }

            sizesList.forEach((size: string) => {
              const sizeBtn = document.createElement('button');
              sizeBtn.type = 'button';
              sizeBtn.className = `border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none ${
                size === activeSize 
                  ? 'border-neutral-900 bg-neutral-900 text-white shadow-sm' 
                  : 'border-neutral-200 bg-neutral-50 text-neutral-700 hover:border-neutral-400'
              }`;
              sizeBtn.textContent = size;
              
              sizeBtn.addEventListener('click', () => {
                activeSize = size;
                const allSizeBtns = modalSizesContainer.querySelectorAll('button');
                allSizeBtns.forEach(b => {
                  b.className = 'border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none border-neutral-200 bg-neutral-50 text-neutral-700 hover:border-neutral-400';
                });
                sizeBtn.className = 'border px-4 py-2 text-xs font-mono font-bold transition-all cursor-pointer focus:outline-none border-neutral-900 bg-neutral-900 text-white shadow-sm';
              });

              modalSizesContainer.appendChild(sizeBtn);
            });

            if (addToCartBtn) {
              addToCartBtn.disabled = false;
              addToCartBtn.textContent = 'Añadir al Carrito';
              addToCartBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
          }
        }
      };

      updateHeaderAndPrice();
      renderPurchaseModeTabs();
      
      if (modalColorsContainer) {
        modalColorsContainer.innerHTML = '';
        activeProduct.variants?.forEach((v: any, index: number) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `w-6 h-6 rounded-full border border-neutral-300 block cursor-pointer transition-all ${index === activeIndex ? 'ring-1 ring-neutral-900 ring-offset-2' : ''}`;
          btn.style.backgroundColor = v.colorHex || '#111827';
          btn.title = v.colorName || 'Color';
          
          btn.addEventListener('click', () => {
            const allModalColorBtns = modalColorsContainer.querySelectorAll('button');
            allModalColorBtns.forEach(b => b.classList.remove('ring-1', 'ring-neutral-900', 'ring-offset-2'));
            btn.classList.add('ring-1', 'ring-neutral-900', 'ring-offset-2');
            updateModalContent(v);
          });

          modalColorsContainer.appendChild(btn);
        });
      }

      updateModalContent(activeVariant);
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';

      setTimeout(() => {
        const contentBox = document.getElementById('product-modal-content');
        if (contentBox) contentBox.focus();
      }, 50);
    });
  });

  if (modal) {
    modal.addEventListener('wheel', (e) => {
      e.stopPropagation();
    }, { passive: true });

    modal.addEventListener('touchmove', (e) => {
      e.stopPropagation();
    }, { passive: true });
  }

  addToCartBtn?.addEventListener('click', () => {
    if (!activeProduct || !activeVariant) return;

    let itemSku = activeProduct.sku;
    let itemName = activeProduct.name;
    let itemPrice = activeProduct.effectivePrice !== undefined ? activeProduct.effectivePrice : activeProduct.price;
    let itemSize = activeSize;

    if (activeProduct.isBundle) {
      if (activePurchaseMode === 'top') {
        const top = activeProduct.topProduct;
        itemSku = top?.sku || activeProduct.sku;
        itemName = top?.name || `${activeProduct.name} (${activeProduct.topLabel || 'Camisa'})`;
        itemPrice = top?.effectivePrice !== undefined ? top.effectivePrice : (top?.price || itemPrice);
        itemSize = activeTopSize;
      } else if (activePurchaseMode === 'bottom') {
        const bottom = activeProduct.bottomProduct;
        itemSku = bottom?.sku || activeProduct.sku;
        itemName = bottom?.name || `${activeProduct.name} (${activeProduct.bottomLabel || 'Short'})`;
        itemPrice = bottom?.effectivePrice !== undefined ? bottom.effectivePrice : (bottom?.price || itemPrice);
        itemSize = activeBottomSize;
      }
    }

    addCartItem({
      sku: itemSku,
      name: itemName,
      price: itemPrice,
      colorName: activeVariant.colorName || 'Único',
      colorHex: activeVariant.colorHex || '#111827',
      size: itemSize,
      image: activeVariant.images?.[0] || ''
    });

    const originalText = addToCartBtn.textContent;
    addToCartBtn.textContent = "¡Añadido Exitosamente!";
    addToCartBtn.classList.remove('bg-neutral-900');
    addToCartBtn.classList.add('bg-amber-600');
    addToCartBtn.disabled = true;

    setTimeout(() => {
      addToCartBtn.textContent = originalText;
      addToCartBtn.classList.remove('bg-amber-600');
      addToCartBtn.classList.add('bg-neutral-900');
      addToCartBtn.disabled = false;
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    }, 800);
  });

  // --- 6. LIGHTBOX ---
  if (modalImg && lightbox && lightboxImg) {
    modalImg.addEventListener('click', () => {
      if (modalImg.src) {
        lightboxImg.src = modalImg.src;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    });
  }

  if (lightbox) {
    lightbox.addEventListener('click', () => {
      lightbox.classList.remove('flex');
      lightbox.classList.add('hidden');
      if (modal && modal.style.display === 'none') {
        document.body.style.overflow = '';
      }
    });
  }

  if (closeModalBtn && modal) {
    closeModalBtn.addEventListener('click', () => {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    });
  }
</script>